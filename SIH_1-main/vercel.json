{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "aicte_approval": {
      "root": "AICTE_Approval",
      "framework": "flask"
    },
    "sih-aicte": {
      "root": "sih-aicte",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "aicte_approval",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "sih-aicte",
        "path": "/$1"
      }
    }
  ]
}
